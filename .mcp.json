{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "bun",
      "args": [".devcontainer/run-chrome-devtools-mcp.ts"],
      "env": {}
    },
    "lapras": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@lapras-inc/lapras-mcp-server"],
      "env": {
        "LAPRAS_API_KEY": "${LAPRAS_API_KEY}"
      }
    }
  }
}
