{
  "name": "cross-recorder",
  "version": "0.13.0",
  "description": "Cross-platform desktop audio recorder built with Electrobun",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "bash scripts/build-native.sh && electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:native": "bash scripts/build-native.sh",
    "build": "bash scripts/ci-free-disk.sh && bash scripts/build-native.sh && vite build && electrobun build --env=stable",
    "build:vite": "vite build",
    "typecheck": "bash -c 'tsc --noEmit --skipLibCheck 2>&1 | grep -v node_modules | grep error && exit 1 || exit 0'",
    "lint": "oxlint -c oxlint.config.mjs",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "test:bats": "bats src/native/linux/capture-system-audio.bats",
    "lint:shell": "shellcheck src/native/linux/*.sh scripts/build-native.sh",
    "format": "oxlint --fix",
    "agent-adapters:generate": "bun scripts/generate-agent-adapters.ts",
    "agent-adapters:check": "bun scripts/generate-agent-adapters.ts --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.2",
    "electrobun": "^1.18.1",
    "framer-motion": "^12.40.0",
    "nanoid": "^5.1.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "overrides": {
      "picomatch@<2.3.2": "^2.3.2"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.83.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
